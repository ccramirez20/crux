{
  "name": "crux",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @crux/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @crux/db exec drizzle-kit migrate",
    "db:studio": "pnpm --filter @crux/db exec drizzle-kit studio",
  "seed:event": "pnpm --filter @crux/db exec node src/seed-event.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "comment": "Pines de seguridad. Duplicados en pnpm-workspace.yaml: pnpm 9 (el de packageManager) solo lee estos; pnpm 10 solo lee los de alla. Si cambias uno, cambia el otro.",
    "overrides": {
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0",
      "esbuild": ">=0.25.0"
    }
  }
}
